# Optional secrets for the Supabase Edge Functions.
# DO NOT put these in the website's .env or commit real values.
# Set them on Supabase with:  npx supabase secrets set KEY=value
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Your site's origin(s), comma separated. Use * only while testing.
ALLOWED_ORIGIN=https://your-site.vercel.app,http://localhost:3000

# Any random string; salts the hashed values used for rate limiting
RATE_SALT=another-long-random-string

# Max uploads per account per hour (default 20) and likes per network address per hour (default 240)
RATE_LIMIT_PER_HOUR=20
LIKE_LIMIT_PER_HOUR=240
